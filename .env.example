# Copy to .env.local and fill in. Set the same vars in Vercel → Project → Settings → Environment Variables.

# MongoDB Atlas connection string (create a least-privilege DB user)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ygo-tournament-tracker?retryWrites=true&w=majority

# Clerk → Dashboard → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Clerk → Dashboard → Webhooks → your endpoint → Signing secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# Use the embedded sign-in/sign-up pages in this app
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
